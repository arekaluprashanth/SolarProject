     <main>
      <!-- Hero Section -->
      <section class="hero">
        <div class="container">
          <div class="hero__content">
            <h1 class="text-uppercase">
              Xoilac TV – Trực tiếp bóng đá tốc độ cao – Trực tuyến Xôi Lạc HD
            </h1>
          </div>
